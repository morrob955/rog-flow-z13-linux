# Z13 Control: let the logged-in user drive the rear light bar (0b05:18c6) hidraw nodes,
# and restore its saved colour whenever it appears (boot, resume, replug).
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="18c6", TAG+="uaccess", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="z13-rear.service"
